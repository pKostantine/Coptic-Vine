{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The liturgical content API: the copy of Supabase's content in D1 (Phase 1
  // of docs/coptic-vine-d1-plan.md), read-only for clients.
  "name": "cv-content-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "content.copticvine.ca", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "copticvine",
      "database_id": "73a769f9-62fe-486d-a3c2-171b9aec274a",
      "migrations_dir": "migrations"
    }
  ],
  // Workers Caching in front of the Content entrypoint only: the default
  // entrypoint runs on every request to read the content revision, which it
  // puts in the URL it asks Content for (src/index.ts).
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Content": { "type": "worker", "cache": { "enabled": true } }
  },
  // Every minute: start the offline-book build when the content has changed
  // and settled (src/publish.ts). Needs the GITHUB_TOKEN secret.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "pKostantine/Coptic-Vine",
    "PUBLISH_WORKFLOW": "publish-content.yml",
    "PUBLISH_REF": "master"
  },
  "observability": {
    "enabled": true
  }
}
