{
  "name": "@coptic-vine/content-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:schema": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-schema.ts",
    "import": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/import.ts",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc -p .",
    "deploy": "wrangler deploy",
    "parity": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/parity.ts",
    "search-verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/search-verify.ts",
    "build-search": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-search.ts"
  }
}
