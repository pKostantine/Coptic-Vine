{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cv-content-packages",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "chc-content"
    }
  ],
  "observability": {
    "enabled": true
  }
}
