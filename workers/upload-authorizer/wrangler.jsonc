{
  "name": "cv-upload-authorizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    // cv-api since the Phase 2 cutover (docs/d1/phase2-runbook.md); Supabase was https://wtuujmeinzqfikvuofmh.supabase.co.
    "SUPABASE_URL": "https://api.copticvine.ca",
    "MAX_UPLOAD_BYTES": "21474836480"
  },
  "r2_buckets": [
    {
      "binding": "SUBMISSIONS_BUCKET",
      "bucket_name": "chc-submissions"
    },
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "chc-music"
    },
    {
      "binding": "LEARNING_BUCKET",
      "bucket_name": "chc-learning"
    },
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "chc-images"
    }
  ]
}
