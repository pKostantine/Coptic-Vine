{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cv-notification-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "vars": {
    // cv-api; the SERVICE_TOKEN secret is its service token.
    "API_URL": "https://api.copticvine.ca"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
