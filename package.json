    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "publish:content": "node scripts/publish-content-packages.mjs",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test:slideshow && npm run test:reading && npm run test:conditions && npm run test:lyrics && npm run test:offline && npm run test:playback && npm run test:music-ui && npm run test:share",
    "test:slideshow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/slideshowLayout.test.mjs tests/slideshowNativeMeasurement.test.cjs tests/bibleSlideshowHtml.test.cjs",
    "test:reading": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/desktopChrome.test.cjs tests/appNotices.test.cjs tests/loadErrors.test.cjs tests/loadCaches.test.cjs tests/keepAwake.test.cjs tests/reducedMotion.test.cjs tests/documentReadings.test.cjs tests/documentThemes.test.cjs tests/selectionMenus.test.cjs tests/readingFontSize.test.mjs tests/documentRestore.test.cjs tests/modalOrientations.test.cjs tests/documentOrnaments.test.cjs",
    "test:conditions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/serviceConditionDates.test.cjs tests/fixedFeasts.test.cjs tests/seasonAppearance.test.cjs tests/lentConditionFlags.test.cjs tests/monasteryConditionFlags.test.cjs tests/conditionParsing.test.cjs tests/sermonPlanner.test.cjs tests/holyWeekManifest.test.cjs tests/lectionaryOutline.test.cjs",
    "test:lyrics": "node --test tests/synchronizedLyrics.test.cjs",
    "test:offline": "node --test tests/offlineDownloadRequests.test.cjs tests/bookDownloads.test.cjs tests/contentReadCache.test.cjs tests/signOutDetach.test.cjs tests/authSignOut.test.cjs",
    "test:playback": "node --test tests/playbackEngine.test.cjs tests/playbackQueue.test.cjs",
    "test:music-ui": "node --test tests/musicLibraryPlaylistUi.test.cjs",
    "test:share": "node --test tests/shareWorker.test.mjs tests/webManifest.test.cjs tests/screenSeal.test.cjs tests/webHeaders.test.cjs",
    "build": "expo export -p web",
    "postbuild": "node scripts/verify-cloudflare-share-worker.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler preview"
  },
  "private": true
}
