{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coptic-vine",
  "main": "./workers/web-app/src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/share/*",
      "/__share-image",
      "/music/artist/*",
      "/music/playlist/*",
      "/music/release/*",
      "/music/track/*",
      "/learn/cantor/*",
      "/learn/album/*",
      "/learn/lesson/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // The link previews' data (workers/web-app): cv-api, also the default when unset.
    "DATA_API_URL": "https://api.copticvine.ca"
  },
  "previews": {}
}
