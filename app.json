{
  "expo": {
    "name": "Coptic Vine",
    "slug": "coptic-vine",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/coptic-vine-icon.png",
    "scheme": [
      "copticvine",
      "coptichymnscentre"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/coptic-vine-icon.png",
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.copticvine.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14301B",
        "foregroundImage": "./assets/images/coptic-vine-android-foreground.png",
        "backgroundImage": "./assets/images/coptic-vine-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.copticvine.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/coptic-vine-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://copticvine.ca"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14301B",
          "image": "./assets/images/coptic-vine-seal.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Coptic Vine to choose a profile or playlist cover photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.42138677998-36niv63hdffgnj8kuvimd3rb7rovobmq"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32a39b3a-6022-4132-962e-e04be1da8af6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aea4f18c-5f12-4986-abb6-47bf0955ab4a"
    },
    "owner": "coptic-vine"
  }
}
